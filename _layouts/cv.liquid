---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if page.cv_pdf %}
  {% if page.cv_pdf contains '://' %}
    {% assign pdf_path = page.cv_pdf %}
  {% else %}
    {% assign pdf_path = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
  {% endif %}
  <!-- Centered narrower PDF embed -->
  <div style="position:relative; top:20px; display:flex; justify-content:center;">
    <object data="{{ pdf_path }}" type="application/pdf" style="width:70vw; height:calc(100vh - 160px); border:0;">
      <iframe src="{{ pdf_path }}" style="width:70vw; height:calc(100vh - 160px); border:0;" title="CV PDF"></iframe>
      <div style="width:70vw; height:calc(100vh - 160px); display:flex; align-items:center; justify-content:center; padding:1rem; font-family:system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;">
        Your browser can’t display embedded PDFs. <a href="{{ pdf_path }}" style="margin-left:0.4rem;">Download the PDF</a>.
      </div>
    </object>
  </div>
  {% endif %}
</div>
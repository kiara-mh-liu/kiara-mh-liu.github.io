---
layout: default
---

{%- assign _raw = page.cv_pdf | default: site.cv_pdf | default: 'cv.pdf' -%}
{%- assign _is_absolute = _raw contains '://' or _raw startswith '/' -%}
{%- if _is_absolute -%}
  {%- assign pdf_path = _raw -%}
{%- else -%}
  {%- assign pdf_path = _raw | prepend: 'assets/pdf/' | relative_url -%}
{%- endif -%}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          href="{{ pdf_path }}"
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        ><i class="fa-solid fa-file-pdf"></i></a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% if page.cv_pdf %}
        <div class="card mt-3 p-0">
          <object data="{{ pdf_path }}#view=FitH" type="application/pdf" class="w-100" style="height:85vh;">
            <iframe src="{{ pdf_path }}#view=FitH" class="w-100" style="height:85vh;" title="CV PDF"></iframe>
            <div class="p-3">
              Your browser can’t display embedded PDFs. You can
              <a href="{{ pdf_path }}">download the CV here</a>.
            </div>
          </object>
        </div>
      {% else %}
        <p>No CV PDF specified for this page.</p>
      {% endif %}
    </div>
  </article>
</div>

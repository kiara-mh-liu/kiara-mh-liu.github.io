---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a href="{{ page.cv_pdf }}" target="_blank" rel="noopener noreferrer" class="float-right">
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if page.cv_pdf %}
  <!-- Full-bleed PDF embed -->
  <object data="{{ page.cv_pdf }}" type="application/pdf" style="position:fixed; top:120px; left:0; width:100vw; height:calc(100vh - 120px); border:0; margin:0; padding:0;">
    <iframe src="{{ page.cv_pdf }}" style="position:fixed; top:120px; left:0; width:100vw; height:calc(100vh - 120px); border:0;" title="CV PDF"></iframe>
    <div style="position:fixed; top:120px; left:0; width:100vw; height:calc(100vh - 120px); display:flex; align-items:center; justify-content:center; padding:1rem; font-family:system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;">
      Your browser can’t display embedded PDFs. <a href="{{ page.cv_pdf }}" style="margin-left:0.4rem;">Download the PDF</a>.
    </div>
  </object>
  {% endif %}
</div>